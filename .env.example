# Prisma / Neon
dashboard_DATABASE_URL="postgresql://user:password@host-pooler.region.neon.tech/dbname?channel_binding=require&sslmode=require"
dashboard_DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.neon.tech/dbname?sslmode=require"

# App
JWT_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OWNER_EMAILS="tu-email@ejemplo.com"
ROADMAP_ADMIN_EMAILS="tu-email@ejemplo.com"

# Optional server settings
CORS_ORIGIN="http://localhost:3000"
CRAWL_MAX_PER_MIN="2"
AI_MAX_PER_MIN="8"
EXPORT_MAX_PER_MIN="12"
CREDENTIAL_ENCRYPTION_KEY="replace-with-32-byte-random-secret"

# AI
OPENAI_API_KEY="sk-..."
OPENAI_SEO_MODEL="gpt-4o-mini"
OPENAI_BLOG_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_SEO_MODEL="claude-3-5-haiku-latest"
ANTHROPIC_BLOG_MODEL="claude-3-5-haiku-latest"

# Google Drive OAuth
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-drive/callback"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_AGENCY="price_..."

# Email (nodemailer) — requerido para recuperar contraseña
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="tu-app-password"
SMTP_FROM="SEO Crawler <tu-email@gmail.com>"

# Optional Next build setting
NEXT_DIST_DIR=".next"
