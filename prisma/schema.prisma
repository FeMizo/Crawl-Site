generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("dashboard_DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  passwordHash            String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  phoneCountry            String?
  phoneNumber             String?
  role                    UserRole                 @default(USER)
  emailVerified           Boolean                  @default(false)
  jobRole                 String?
  teamOwnerId             String?
  crawlRuns               CrawlRun[]
  crawlSchedules          CrawlSchedule[]
  googleDriveConnections  GoogleDriveConnection[]
  googleProjectBindings   ProjectGoogleBinding[]
  googleInsightSnapshots  GoogleInsightSnapshot[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  projects                Project[]
  subscription            Subscription?
  teamOwner               User?                    @relation("TeamMembers", fields: [teamOwnerId], references: [id])
  teamMembers             User[]                   @relation("TeamMembers")

  @@index([teamOwnerId])
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  plan              PlanType  @default(FREE)
  stripeCustomerId  String?
  stripeSubId       String?
  maxProjects       Int       @default(1)
  maxPagesPerCrawl  Int       @default(50)
  maxCrawlsPerMonth Int       @default(2)
  maxHistoryRuns    Int       @default(1)
  features          String[]  @default([])
  expiresAt         DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  projectsCreated   Int       @default(0)
  trialEndsAt       DateTime?
  crawlsResetAt     DateTime?
  crawlsThisMonth   Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeSubId])
  @@index([stripeCustomerId])
}

model Project {
  id            String         @id @default(cuid())
  userId        String
  name          String
  targetUrl     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  crawlRuns     CrawlRun[]
  crawlSchedule CrawlSchedule?
  googleBinding ProjectGoogleBinding?
  googleInsightSnapshots GoogleInsightSnapshot[]
  aiSeoRecommendations AiSeoRecommendation[]
  blogDrafts    BlogDraft[]
  wordpressConnection WordPressConnection?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CrawlSchedule {
  id         String    @id @default(cuid())
  userId     String
  projectId  String    @unique
  frequency  String    @default("weekly")
  maxPages   Int       @default(50)
  renderMode String    @default("auto")
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, nextRunAt])
}

model CrawlAlert {
  id            String   @id @default(cuid())
  userId        String
  projectId     String
  runId         String
  previousRunId String?
  type          String
  severity      String
  title         String
  message       String
  payload       Json?
  readAt        DateTime?
  emailedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([userId, readAt])
  @@index([runId])
}

model CrawlRun {
  id           String              @id @default(cuid())
  userId       String
  projectId    String
  sourceUrl    String
  maxPages     Int
  rateDelay    Int
  checkExt     Boolean
  total        Int                 @default(0)
  withIssues   Int                 @default(0)
  stats        Json?
  downloadName String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sourceType   String              @default("crawl")
  status       CrawlStatus         @default(COMPLETED)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  storedDups   CrawlRunDuplicate[]
  storedPages  CrawlRunPage[]
  aiSeoRecommendations AiSeoRecommendation[]
  blogDrafts   BlogDraft[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model AiSeoRecommendation {
  id                String   @id @default(cuid())
  userId            String
  projectId         String
  runId             String
  pageUrl           String
  primaryKeyword    String
  secondaryKeywords String[] @default([])
  intent            String?
  suggestedTitle    String?
  suggestedMeta     String?
  suggestedH1       String?
  suggestedH2s      String[] @default([])
  recommendations   String[] @default([])
  provider          String   @default("local")
  model             String?
  payload           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run               CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, pageUrl])
  @@index([userId, projectId])
}

model BlogDraft {
  id             String   @id @default(cuid())
  userId         String
  projectId      String
  runId          String?
  title          String
  slug           String
  excerpt        String?
  content        String
  keywords       String[] @default([])
  brief          Json?
  status         String   @default("draft")
  wpPostId       String?
  wpPostUrl      String?
  driveFileId    String?
  driveFileUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run            CrawlRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, projectId, createdAt])
  @@index([projectId, slug])
}

model WordPressConnection {
  id                    String   @id @default(cuid())
  userId                String
  projectId             String   @unique
  siteUrl               String
  username              String
  encryptedAppPassword  String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GoogleDriveConnection {
  id                    String   @id @default(cuid())
  userId                String
  email                 String?
  folderId              String?
  scopes                String[] @default([])
  status                String   @default("connected")
  encryptedAccessToken  String?
  encryptedRefreshToken String
  expiryDate            DateTime?
  lastSyncAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model ProjectGoogleBinding {
  id                    String   @id @default(cuid())
  userId                String
  projectId             String   @unique
  searchConsoleProperty  String?
  ga4PropertyId         String?
  status                String   @default("active")
  lastSyncAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots             GoogleInsightSnapshot[]

  @@index([userId])
  @@index([status, lastSyncAt])
}

model GoogleInsightSnapshot {
  id             String   @id @default(cuid())
  userId         String
  projectId      String
  bindingId      String?
  source         String
  snapshotDate   DateTime
  summary        Json
  rows           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  binding        ProjectGoogleBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, source, snapshotDate])
  @@index([userId, createdAt])
  @@index([projectId, source, snapshotDate])
}

model CrawlRunPage {
  id          String   @id @default(cuid())
  runId       String
  position    Int
  url         String
  finalUrl    String?
  statusCode  Int?
  hasIssues   Boolean  @default(false)
  title       String?
  titleLen    Int      @default(0)
  description String?
  descLen     Int      @default(0)
  payload     Json
  createdAt   DateTime @default(now())
  run         CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, position])
  @@index([runId, hasIssues, position])
  @@index([url])
}

model CrawlRunDuplicate {
  id        String   @id @default(cuid())
  runId     String
  position  Int
  title     String
  urlCount  Int      @default(0)
  payload   Json
  createdAt DateTime @default(now())
  run       CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, position])
  @@index([runId, urlCount])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RoadmapPhase {
  id          String        @id @default(cuid())
  title       String
  description String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks       RoadmapTask[]

  @@index([position])
}

model RoadmapTask {
  id        String       @id @default(cuid())
  phaseId   String
  title     String
  completed Boolean      @default(false)
  position  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  phase     RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId, position])
}

enum UserRole {
  OWNER
  SUPER_ADMIN
  ADMIN
  EDITOR
  USER
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlanType {
  FREE
  STARTER
  PRO
  AGENCY
  BASIC
}

model RateLimitEntry {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
