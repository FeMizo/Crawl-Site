generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("dashboard_DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  passwordHash            String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  phoneCountry            String?
  phoneNumber             String?
  role                    UserRole                 @default(USER)
  emailVerified           Boolean                  @default(false)
  jobRole                 String?
  teamOwnerId             String?
  crawlRuns               CrawlRun[]
  crawlSchedules          CrawlSchedule[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  projects                Project[]
  subscription            Subscription?
  teamOwner               User?                    @relation("TeamMembers", fields: [teamOwnerId], references: [id])
  teamMembers             User[]                   @relation("TeamMembers")

  @@index([teamOwnerId])
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  plan              PlanType  @default(FREE)
  stripeCustomerId  String?
  stripeSubId       String?
  maxProjects       Int       @default(1)
  maxPagesPerCrawl  Int       @default(50)
  maxCrawlsPerMonth Int       @default(2)
  maxHistoryRuns    Int       @default(1)
  features          String[]  @default([])
  expiresAt         DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  projectsCreated   Int       @default(0)
  trialEndsAt       DateTime?
  crawlsResetAt     DateTime?
  crawlsThisMonth   Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeSubId])
  @@index([stripeCustomerId])
}

model Project {
  id            String         @id @default(cuid())
  userId        String
  name          String
  targetUrl     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  crawlRuns     CrawlRun[]
  crawlSchedule CrawlSchedule?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CrawlSchedule {
  id         String    @id @default(cuid())
  userId     String
  projectId  String    @unique
  frequency  String    @default("weekly")
  maxPages   Int       @default(50)
  renderMode String    @default("auto")
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, nextRunAt])
}

model CrawlRun {
  id           String              @id @default(cuid())
  userId       String
  projectId    String
  sourceUrl    String
  maxPages     Int
  rateDelay    Int
  checkExt     Boolean
  total        Int                 @default(0)
  withIssues   Int                 @default(0)
  stats        Json?
  downloadName String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sourceType   String              @default("crawl")
  status       CrawlStatus         @default(COMPLETED)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  storedDups   CrawlRunDuplicate[]
  storedPages  CrawlRunPage[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model CrawlRunPage {
  id          String   @id @default(cuid())
  runId       String
  position    Int
  url         String
  finalUrl    String?
  statusCode  Int?
  hasIssues   Boolean  @default(false)
  title       String?
  titleLen    Int      @default(0)
  description String?
  descLen     Int      @default(0)
  payload     Json
  createdAt   DateTime @default(now())
  run         CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, position])
  @@index([runId, hasIssues, position])
  @@index([url])
}

model CrawlRunDuplicate {
  id        String   @id @default(cuid())
  runId     String
  position  Int
  title     String
  urlCount  Int      @default(0)
  payload   Json
  createdAt DateTime @default(now())
  run       CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, position])
  @@index([runId, urlCount])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RoadmapPhase {
  id          String        @id @default(cuid())
  title       String
  description String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks       RoadmapTask[]

  @@index([position])
}

model RoadmapTask {
  id        String       @id @default(cuid())
  phaseId   String
  title     String
  completed Boolean      @default(false)
  position  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  phase     RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId, position])
}

enum UserRole {
  OWNER
  SUPER_ADMIN
  ADMIN
  EDITOR
  USER
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlanType {
  FREE
  STARTER
  PRO
  AGENCY
  BASIC
}

model RateLimitEntry {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
